rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function acesso() {
      return get(/databases/$(database)/documents/acessos/$(request.auth.uid)).data;
    }
    // Aparelho liberado = já digitou um PIN válido (editor ou leitura).
    function leitor() {
      return request.auth != null
        && exists(/databases/$(database)/documents/acessos/$(request.auth.uid))
        && acesso().get('papel', '') in ['editor', 'leitura'];
    }
    function editor() {
      return leitor() && acesso().papel == 'editor';
    }
    function pinOk(d) {
      let s = get(/databases/$(database)/documents/config/secreto).data;
      return (d.papel == 'editor' && d.pin == s.get('editor', null) && s.get('editor', null) != null)
          || (d.papel == 'leitura' && d.pin == s.get('leitura', null) && s.get('leitura', null) != null);
    }

    // PINs ficam aqui; ninguém lê pelo navegador (só a automação, com chave de serviço).
    match /config/{doc} {
      allow read, write: if false;
    }

    // Cada aparelho registra o próprio acesso informando o PIN.
    match /acessos/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['pin', 'papel', 'em'])
        && pinOk(request.resource.data);
      allow delete: if false;
    }

    // Todos os dados do app: quem tem PIN lê; só o PIN de editor grava.
    match /eventos/{doc=**} {
      allow read: if leitor();
      allow write: if editor();
    }
  }
}
